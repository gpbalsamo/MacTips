{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["ollama"],
  "model": "ollama/qwen2.5-coder:7b",
  "small_model": "ollama/qwen2.5-coder:7b",
  "default_agent": "plan",
  "autoupdate": false,
  "share": "disabled",
  "snapshot": false,
  "formatter": false,
  "lsp": false,
  "plugin": [],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama on RTXG (local)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "timeout": 60000
      },
      "models": {
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B (local)",
          "limit": {"context": 8192, "output": 1024},
          "options": {"num_ctx": 8192}
        }
      }
    }
  },
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/.aws/**": "deny",
      "**/.codex/**": "deny",
      "**/.git/**": "deny",
      "**/runtime/**": "deny",
      "**/.venv/**": "deny",
      "**/models/**": "deny"
    },
    "glob": "allow",
    "grep": "ask",
    "edit": "ask",
    "bash": "ask",
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "codesearch": "deny",
    "task": "deny"
  }
}
